# ============================================================
# Secrets & real VPN material — NEVER commit
# ============================================================
# Environment files (keep only the template, if one ever appears)
.env
.env.*
!.env.example

# Keys and certificates
*.key
*.pem
*.crt
*.cert
*.p12
*.pfx
id_rsa*
id_ed25519*

# Generated WireGuard / AmneziaWG configs contain private keys.
# Only the nginx templates in deploy/ are tracked.
*.conf
!/deploy/**/*.conf

# ============================================================
# Node.js
# ============================================================
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.node_repl_history
*.tgz

# npm is the package manager of record (package-lock.json is tracked)
yarn.lock
pnpm-lock.yaml

# Tooling caches & test output
.eslintcache
.cache/
coverage/
.nyc_output/

# ============================================================
# Python (deploy/controller tests)
# ============================================================
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# ============================================================
# Build & output
# ============================================================
/dist/
/build/
/.output/

# ============================================================
# Vercel
# ============================================================
.vercel/

# ============================================================
# Logs & temporary files
# ============================================================
*.log
*.log.*
logs/
/.tmp/
/tmp/
*.tmp
*.bak
*.swp
*.swo
*.orig
*.rej

# ============================================================
# OS generated files
# ============================================================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.trash/
*~

# ============================================================
# IDE / Editor
# ============================================================
.idea/
.vscode/
.history/
.fleet/
*.code-workspace
*.sublime-workspace
*.sublime-project

# ============================================================
# Local agent context (never part of the published project)
# ============================================================
# Personal tool state of the maintainer lives in .git/info/exclude;
# these few entries stay here as a safety net against `git add -A`.
.claude/
CLAUDE.md
.mcp.json
.codegraph/
