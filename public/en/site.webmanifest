{
  "id": "/en",
  "name": "AmneziaWG Config Generator",
  "short_name": "AWG Config",
  "description": "WARP-safe .conf for AmneziaWG 1.5, 2.0, 3.0 and 3.1 on top of Cloudflare WARP: route presets, DNS and CPS obfuscation.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/en",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#07090c",
  "theme_color": "#07090c",
  "categories": ["utilities", "productivity"],
  "icons": [
    {
      "src": "/static/icon-192.png?v=3.1.8",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-512.png?v=3.1.8",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "prefer_related_applications": false
}
