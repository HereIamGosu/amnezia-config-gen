# Endpoint Lab discovery: small bounded candidate checks. Installed disabled by install.sh.
# It yields to refresh (skips when the lock is held) and to host pressure (resource guard).
[Unit]
Description=Endpoint Lab: bounded discovery of WARP endpoint candidates
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/endpoint-lab discovery
TimeoutStartSec=300
Nice=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/amnezia-endpoint-lab /run
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_NET_RAW CAP_SYS_MODULE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ProtectClock=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
MemoryMax=128M
TasksMax=64
